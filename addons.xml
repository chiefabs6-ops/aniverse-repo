<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.aniverse" name="AniVerse" version="0.9.2" provider-name="AniVerse">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="script.module.pyqrcode" version="1.2.1"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <reuselanguageinvoker>true</reuselanguageinvoker>
    <summary lang="en_GB">Personal anime add-on with TorBox or Real-Debrid playback</summary>
    <description lang="en_GB">Browse anime, choose a source yourself and play it through your own TorBox (or Real-Debrid) account. For personal use.</description>
    <platform>all</platform>
    <license>Personal use</license>
    <news>0.9.2: test update to check repository update notices. No changes to how AniVerse works.</news>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.png</fanart>
    </assets>
  </extension>
</addon>
<addon id="plugin.video.aniverse" name="AniVerse" version="0.9.1" provider-name="AniVerse">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="script.module.pyqrcode" version="1.2.1"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <reuselanguageinvoker>true</reuselanguageinvoker>
    <summary lang="en_GB">Personal anime add-on with TorBox or Real-Debrid playback</summary>
    <description lang="en_GB">Browse anime, choose a source yourself and play it through your own TorBox (or Real-Debrid) account. For personal use.</description>
    <platform>all</platform>
    <license>Personal use</license>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.png</fanart>
    </assets>
  </extension>
</addon>
<!-- Points Kodi at the AniVerse update feed (DEC-038/039). REPO_URL in tools/build.py must match. -->
<addon id="repository.aniverse" name="AniVerse Repository" version="1.0.0" provider-name="AniVerse">
  <extension point="xbmc.addon.repository" name="AniVerse Repository">
    <dir minversion="19.0.0">
      <info compressed="false">https://chiefabs6-ops.github.io/aniverse-repo/addons.xml</info>
      <checksum verify="sha256">https://chiefabs6-ops.github.io/aniverse-repo/addons.xml.sha256</checksum>
      <datadir zip="true">https://chiefabs6-ops.github.io/aniverse-repo/</datadir>
      <hashes>sha256</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Updates for AniVerse</summary>
    <description lang="en_GB">Install this once; Kodi then offers AniVerse updates from it.</description>
    <platform>all</platform>
    <license>Personal use</license>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.png</fanart>
    </assets>
  </extension>
</addon>
</addons>
